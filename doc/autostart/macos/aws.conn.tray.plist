<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>aws.conn.tray</string>
  <key>ProgramArguments</key>
  <array>
    <!-- インストーラで作成される .venv の Python を指定してください -->
    <string>/Users/YOUR_USERNAME/aws-conn-tray/.venv/bin/python3</string>
    <string>/Users/YOUR_USERNAME/aws-conn-tray/tray_app.py</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
</dict>
</plist>
