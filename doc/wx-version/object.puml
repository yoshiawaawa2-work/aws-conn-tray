@startuml object_wx_app
title オブジェクト図（起動時の主要インスタンス）

object "wx_tray_app" as Wx {
  state = "監視中"
  icon = "green/yellow/red"
}

object "cfg" as Config {
  profile = "PS-Admin-snapvalue-jp"
  region = "ap-northeast-1"
  local_port = 15432
  remote_port = 5432
  sso_login_timeout_seconds = 900
  sso_auto_refresh_margin_seconds = 300
  tunnel_check_interval_seconds = 5
}

object "token_checker" as TokenChecker {
  token_status = "valid/invalid"
  remaining_sec = "<remaining>"
}

object "ssm_pf" as SsmPortForward {
  state = "running"
}

object "mini_prompt" as MiniPrompt {
  visible = false
}

object "qt_runner" as QWebViewRunner {
  storage = "~/.cache/aws-rds-tray/qt-webview"
}

Wx --> cfg
Wx --> token_checker
Wx --> ssm_pf
Wx --> mini_prompt
token_checker --> qt_runner

@enduml
